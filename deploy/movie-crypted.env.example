# Movie Crypted on TrueNAS (arr stack). Save next to compose.yaml as movie-crypted.env
# Service names resolve on the stack network; use http://<nas-ip>:8096 style URLs if the containers are on different networks.
JELLYFIN_URL=http://jellyfin:8096
JELLYSEERR_URL=http://jellyseerr:5055
JELLYSEERR_API_KEY=paste-your-jellyseerr-api-key
SESSION_SECRET=generate-64-hex-chars-see-README
COOKIE_SECURE=true
DATA_DIR=/app/data
# Shown on the login page as the 'Contact' link. Leave empty to hide the link.
CONTACT_EMAIL=you@example.com
